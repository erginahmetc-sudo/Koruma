{
  "_meta": {
    "source": "gitleaks/gitleaks config/gitleaks.toml'dan türetilmiş yüksek güvenli alt küme"
  },
  "rules": [
    {
      "name": "AWS erişim anahtarı",
      "severity": "CRITICAL",
      "ci": false,
      "regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b"
    },
    {
      "name": "Google API anahtarı",
      "severity": "MEDIUM",
      "ci": false,
      "regex": "\\b(AIza[\\w-]{35})"
    },
    {
      "name": "Google OAuth istemci sırrı",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\b(GOCSPX-[A-Za-z0-9_-]{28})\\b"
    },
    {
      "name": "Azure AD istemci sırrı",
      "severity": "HIGH",
      "ci": false,
      "regex": "(?:^|[\\\\'\\\"\\x60\\s>=:(,)])([a-zA-Z0-9_~.]{3}\\dQ~[a-zA-Z0-9_~.-]{31,34})(?:$|[\\\\'\\\"\\x60\\s<),])"
    },
    {
      "name": "Stripe gizli anahtarı",
      "severity": "CRITICAL",
      "ci": false,
      "regex": "\\b((?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99})\\b"
    },
    {
      "name": "GitHub kişisel erişim token (PAT)",
      "severity": "CRITICAL",
      "ci": false,
      "regex": "\\bghp_[0-9a-zA-Z]{36}\\b"
    },
    {
      "name": "GitHub fine-grained PAT",
      "severity": "CRITICAL",
      "ci": false,
      "regex": "\\bgithub_pat_\\w{82}\\b"
    },
    {
      "name": "GitHub OAuth token",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\bgho_[0-9a-zA-Z]{36}\\b"
    },
    {
      "name": "GitHub app token",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\b(?:ghu|ghs)_[0-9a-zA-Z]{36}\\b"
    },
    {
      "name": "GitHub refresh token",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\bghr_[0-9a-zA-Z]{36}\\b"
    },
    {
      "name": "GitLab PAT",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\bglpat-[\\w-]{20}\\b"
    },
    {
      "name": "Slack bot token",
      "severity": "HIGH",
      "ci": false,
      "regex": "xoxb-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*"
    },
    {
      "name": "Slack user token",
      "severity": "HIGH",
      "ci": false,
      "regex": "xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34}"
    },
    {
      "name": "Slack app token",
      "severity": "HIGH",
      "ci": true,
      "regex": "xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]+"
    },
    {
      "name": "Slack webhook",
      "severity": "HIGH",
      "ci": false,
      "regex": "(?:https?://)?hooks\\.slack\\.com/(?:services|workflows|triggers)/[A-Za-z0-9+/]{43,56}"
    },
    {
      "name": "Twilio API anahtarı",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\bSK[0-9a-fA-F]{32}\\b"
    },
    {
      "name": "SendGrid API token",
      "severity": "HIGH",
      "ci": true,
      "regex": "\\b(SG\\.[a-z0-9=_\\-.]{66})"
    },
    {
      "name": "Mailgun özel API anahtarı",
      "severity": "HIGH",
      "ci": true,
      "regex": "(key-[a-f0-9]{32})"
    },
    {
      "name": "Heroku API anahtarı",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\b(HRKU-AA[0-9a-zA-Z_-]{58})\\b"
    },
    {
      "name": "DigitalOcean PAT",
      "severity": "CRITICAL",
      "ci": false,
      "regex": "\\b((?:dop|doo|dor)_v1_[a-f0-9]{64})\\b"
    },
    {
      "name": "npm token",
      "severity": "HIGH",
      "ci": true,
      "regex": "\\b(npm_[a-z0-9]{36})\\b"
    },
    {
      "name": "PyPI yükleme token",
      "severity": "HIGH",
      "ci": false,
      "regex": "pypi-AgEIcHlwaS5vcmc[\\w-]{50,1000}"
    },
    {
      "name": "Square erişim token",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\b((?:EAAA|sq0atp-)[\\w-]{22,60})\\b"
    },
    {
      "name": "Shopify erişim token",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\bshp(?:at|ca|pa|ss)_[a-fA-F0-9]{32}\\b"
    },
    {
      "name": "Facebook sayfa erişim token",
      "severity": "HIGH",
      "ci": true,
      "regex": "\\b(EAA[MC][a-z0-9]{100,})"
    },
    {
      "name": "OpenAI API anahtarı",
      "severity": "CRITICAL",
      "ci": false,
      "regex": "\\b(sk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}T3BlbkFJ[A-Za-z0-9_-]{20,}|sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})\\b"
    },
    {
      "name": "Anthropic API anahtarı",
      "severity": "CRITICAL",
      "ci": false,
      "regex": "\\b(sk-ant-(?:api03|admin01)-[a-zA-Z0-9_-]{93}AA)\\b"
    },
    {
      "name": "Stripe yayın anahtarı (pk_live)",
      "severity": "LOW",
      "ci": false,
      "regex": "\\bpk_live_[a-zA-Z0-9]{20,}\\b"
    },
    {
      "name": "JSON Web Token (JWT)",
      "severity": "MEDIUM",
      "ci": false,
      "regex": "\\b(ey[a-zA-Z0-9]{17,}\\.ey[a-zA-Z0-9/\\\\_-]{17,}\\.(?:[a-zA-Z0-9/\\\\_-]{10,}={0,2})?)"
    },
    {
      "name": "Özel anahtar (private key)",
      "severity": "CRITICAL",
      "ci": true,
      "regex": "-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----"
    },
    {
      "name": "Firebase bulut mesajlaşma anahtarı",
      "severity": "HIGH",
      "ci": false,
      "regex": "\\bAAAA[A-Za-z0-9_-]{7}:[A-Za-z0-9_-]{140,}"
    }
  ]
}